<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Base44 Encoder</title>

<style>
body{
    font-family: Arial, sans-serif;
    background:#0f172a;
    color:white;
    display:flex;
    justify-content:center;
    align-items:center;
    min-height:100vh;
    margin:0;
}

.card{
    width:90%;
    max-width:800px;
    background:#1e293b;
    padding:20px;
    border-radius:15px;
}

h1{
    text-align:center;
}

textarea{
    width:100%;
    height:150px;
    padding:10px;
    border:none;
    border-radius:10px;
    resize:vertical;
    margin-bottom:10px;
}

button{
    padding:12px 20px;
    border:none;
    border-radius:10px;
    cursor:pointer;
    margin-right:10px;
    margin-bottom:10px;
    font-size:16px;
}

.encode{background:#2563eb;color:white;}
.decode{background:#16a34a;color:white;}
.copy{background:#f59e0b;color:black;}

#output{
    margin-top:15px;
    padding:15px;
    background:#0f172a;
    border-radius:10px;
    word-break:break-all;
}
</style>
</head>
<body>

<div class="card">
    <h1>Base44 Encoder</h1>

    <textarea id="input" placeholder="Enter text here..."></textarea>

    <button class="encode" onclick="encodeBase44()">Encode</button>
    <button class="decode" onclick="decodeBase44()">Decode</button>
    <button class="copy" onclick="copyOutput()">Copy</button>

    <div id="output"></div>
</div>

<script>
const ALPHABET =
"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ-._*+/";
const BASE = 44;

function textToBytes(text){
    return new TextEncoder().encode(text);
}

function bytesToText(bytes){
    return new TextDecoder().decode(bytes);
}

function encodeBase44(){

    const text = document.getElementById("input").value;
    const bytes = textToBytes(text);

    let num = 0n;

    for(const b of bytes){
        num = (num << 8n) + BigInt(b);
    }

    if(num === 0n){
        document.getElementById("output").textContent = ALPHABET[0];
        return;
    }

    let result = "";

    while(num > 0n){
        let rem = Number(num % BigInt(BASE));
        result = ALPHABET[rem] + result;
        num /= BigInt(BASE);
    }

    document.getElementById("output").textContent = result;
}

function decodeBase44(){

    const input = document.getElementById("input").value.trim();

    let num = 0n;

    for(const ch of input){
        const idx = ALPHABET.indexOf(ch);

        if(idx === -1){
            alert("Invalid Base44 character: " + ch);
            return;
        }

        num = num * BigInt(BASE) + BigInt(idx);
    }

    let bytes = [];

    while(num > 0n){
        bytes.unshift(Number(num & 255n));
        num >>= 8n;
    }

    const text = bytesToText(new Uint8Array(bytes));

    document.getElementById("output").textContent = text;
}

function copyOutput(){
    navigator.clipboard.writeText(
        document.getElementById("output").textContent
    );
}
</script>

</body>
</html>